Options -Indexes
DirectoryIndex index.php index.html

<IfModule mod_expires.c>
    ExpiresActive Off
</IfModule>

<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Access-Control-Allow-Origin
    Header always unset Access-Control-Allow-Origin
    Header unset Access-Control-Allow-Methods
    Header always unset Access-Control-Allow-Methods

    Header unset X-Frame-Options
    Header always set X-Frame-Options "SAMEORIGIN"

    Header unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'; script-src 'self' https://connect.facebook.net https://js.pusher.com; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' https://www.facebook.com https://i.ytimg.com; media-src 'self'; connect-src 'self' wss://ws-ap1.pusher.com https://sockjs-ap1.pusher.com https://sockjs.pusher.com https://stats.pusher.com https://connect.facebook.net https://www.facebook.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://www.facebook.com https://web.facebook.com https://calendar.google.com; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests"

    Header unset X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"

    Header unset Referrer-Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    Header unset Permissions-Policy
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

    Header unset Strict-Transport-Security
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    Header unset Cache-Control
    Header always set Cache-Control "no-cache, no-store, must-revalidate, private"

    Header unset Pragma
    Header always set Pragma "no-cache"

    Header unset Expires
    Header always set Expires "0"
</IfModule>

<FilesMatch "\.(mp4|webm|ogg|mp3)$">
    <IfModule mod_headers.c>
        Header unset Cache-Control
        Header always set Cache-Control "private, max-age=3600"
        Header unset Pragma
        Header always unset Pragma
        Header unset Expires
        Header always unset Expires
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block bare directory requests to /assets or /uploads
    RewriteRule ^(assets|uploads)/?$ - [R=404,L,NC]

    # Route API requests to Laravel's index.php (NOTE: REQUEST_URI is /public/api/... after root rewrite!)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} ^/(public/)?api/ [NC]
    RewriteRule ^(.*)$ index.php/$1 [L]

    # Serve index.html and existing static files directly
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Serve React SPA only for valid application routes
    RewriteRule ^(kiosk|tv|login|teller|admin|lobby)(/.*)?$ /index.html [L,NC]

    # Return 404 for unknown paths (e.g. /sitemap.xml) instead of serving index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ - [R=404,L]
</IfModule>
