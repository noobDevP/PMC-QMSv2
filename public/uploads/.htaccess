Options -Indexes -ExecCGI

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phar|pht|shtml|cgi|pl|py|sh|asp|aspx|jsp|svg|html|htm|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule \.(php|phtml|php[0-9]|phar|pht|shtml|cgi|pl|py|sh|svg|html|htm|js)$ - [F,L,NC]
</IfModule>
